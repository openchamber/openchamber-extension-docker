{
  "name": "openchamber-docker",
  "version": "1.1.0",
  "description": "Docker for OpenChamber: your project's Compose stack first, live CPU and memory, logs, files, a shell, disk cleanup, and a one-line reason when a container crashes.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.5.0"
    },
    "contributes": {
      "panel": {
        "id": "docker",
        "name": "Docker",
        "icon": "icon.svg",
        "entry": "panel/index.html"
      },
      "statusSection": {
        "entry": "status/index.html",
        "source": {
          "path": "/status",
          "interval": 3000
        },
        "title": "Docker",
        "height": 72,
        "requiresProject": true
      },
      "background": {
        "entry": "background/index.html"
      },
      "commands": [
        {
          "name": "docker",
          "description": "Attach a container's state and recent logs"
        }
      ],
      "capabilities": ["model"],
      "service": {
        "entry": "service/main.js",
        "runtime": "host",
        "permissions": {
          "exec": ["docker", "docker-compose", "colima", "orb", "open"]
        }
      },
      "attach": false
    }
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "pack": "bun run build && rm -f docker-extension.zip && zip -r docker-extension.zip package.json icon.svg README.md LICENSE panel status background service"
  },
  "devDependencies": {
    "@openchamber/sdk": "^2.5.0",
    "@types/bun": "^1.4.2",
    "typescript": "^5.9.2"
  }
}
